#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
project="$repository_root/game"
mode=all
run_id=game-latest
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) printf '%s\n' 'Usage: scripts/check-game [--mode unit|integration|replay|test|build|all] [--run-id ID]'; exit 0 ;;
    --mode) case "${2-}" in unit|integration|replay|test|build|all) mode="$2"; shift 2 ;; *) printf '%s\n' 'check-game: invalid --mode' >&2; exit 64 ;; esac ;;
    --run-id) run_id="${2-}"; shift 2 ;;
    *) printf 'check-game: unknown option: %s\n' "$1" >&2; exit 64 ;;
  esac
done
case "$run_id" in ''|*[!A-Za-z0-9._-]*) printf '%s\n' 'check-game: --run-id must contain only letters, digits, dot, underscore, or hyphen' >&2; exit 64 ;; esac
report_dir="$repository_root/artifacts/reports/$run_id"
build_dir="$repository_root/artifacts/builds/$run_id"
mkdir -p "$report_dir" "$build_dir"
imported=0
ensure_imported() {
  if [ "$imported" -eq 0 ]; then
    "$script_dir/godot" --headless --editor --path "$project" --quit --log-file "$report_dir/import.log"
    imported=1
  fi
}
run_suite() {
  suite="$1"
  marker="$2"
  ensure_imported
  "$script_dir/godot" --headless --path "$project" --script "res://tests/run_${suite}_tests.gd" --log-file "$report_dir/${suite}.log"
  rg -q "$marker" "$report_dir/${suite}.log" || { printf 'check-game: %s success marker missing\n' "$suite" >&2; exit 1; }
}
run_unit() { run_suite unit PANBEAT_UNIT_TESTS_OK; run_suite p202 PANBEAT_P202_TESTS_OK; run_suite p203 PANBEAT_P203_TESTS_OK; run_suite p204 PANBEAT_P204_TESTS_OK; run_suite p205 PANBEAT_P205_TESTS_OK; run_suite p207 PANBEAT_P207_TESTS_OK; run_suite p208 PANBEAT_P208_TESTS_OK; run_suite p209 PANBEAT_P209_TESTS_OK; run_suite p210 PANBEAT_P210_TESTS_OK; run_suite p211 PANBEAT_P211_TESTS_OK; run_suite p212 PANBEAT_P212_TESTS_OK; run_suite p213 PANBEAT_P213_TESTS_OK; run_suite p302 PANBEAT_P302_TESTS_OK; run_suite p303 PANBEAT_P303_TESTS_OK; run_suite p304 PANBEAT_P304_TESTS_OK; run_suite p305 PANBEAT_P305_TESTS_OK; run_suite p306 PANBEAT_P306_TESTS_OK; run_suite p307 PANBEAT_P307_TESTS_OK; run_suite p308 PANBEAT_P308_TESTS_OK; run_suite p309 PANBEAT_P309_TESTS_OK; run_suite p310 PANBEAT_P310_TESTS_OK; run_suite p401 PANBEAT_P401_TESTS_OK; run_suite background PANBEAT_BACKGROUND_TESTS_OK; }
run_integration() { run_suite integration PANBEAT_INTEGRATION_TESTS_OK; }
run_replay() { run_suite replay PANBEAT_REPLAY_TESTS_OK; }
run_test() { run_unit; run_integration; run_replay; }
run_build() { ensure_imported; "$script_dir/godot" --headless --path "$project" --export-release macOS "$build_dir/PanBeat.zip" --log-file "$report_dir/build.log"; }
case "$mode" in unit) run_unit ;; integration) run_integration ;; replay) run_replay ;; test) run_test ;; build) run_build ;; all) run_test; run_build ;; esac
printf 'check-game: %s succeeded\n' "$mode"
