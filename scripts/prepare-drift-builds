#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
build_root="$repository_root/artifacts/builds/e03-release-drift"
report_root="$repository_root/artifacts/reports/e03-release-drift"
mkdir -p "$build_root/unity" "$build_root/godot" "$report_root"
"$script_dir/build-unity-midi-plugin"
"$script_dir/unity" -batchmode -nographics -quit -projectPath "$repository_root/pocs/unity" \
  -executeMethod PanBeat.Editor.BuildCommand.BuildMacRelease \
  -panbeatBuildPath "$build_root/unity/PanBeat.app" \
  -logFile "$report_root/unity-build.log"
"$script_dir/godot" --headless --path "$repository_root/pocs/godot" \
  --export-release macOS "$build_root/godot/PanBeat.zip" \
  --log-file "$report_root/godot-build.log"
ditto -x -k "$build_root/godot/PanBeat.zip" "$build_root/godot"
