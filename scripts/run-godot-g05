#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
output_dir="$repository_root/artifacts/raw/godot-g05"
mkdir -p "$output_dir" "$repository_root/artifacts/reports/godot-g05"
"$script_dir/godot" --headless --path "$repository_root/pocs/godot" \
  --script res://tests/run_slice.gd --log-file "$repository_root/artifacts/reports/godot-g05/run.log" -- \
  --repository-root "$repository_root" --output-dir "$output_dir"
