#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
"$script_dir/build-unity-midi-plugin"
mkdir -p "$repository_root/artifacts/raw/unity-u05" "$repository_root/artifacts/reports/unity-u05"
"$script_dir/unity" -batchmode -nographics -quit -projectPath "$repository_root/pocs/unity" \
  -executeMethod PanBeat.Editor.UnitySliceCommand.Run \
  -panbeatSliceOutputDir "$repository_root/artifacts/raw/unity-u05" \
  -logFile "$repository_root/artifacts/reports/unity-u05/run.log"
