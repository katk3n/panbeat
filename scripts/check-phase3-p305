#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
run_id=${1:-phase3-p305-field-latest}
case "$run_id" in ''|*[!A-Za-z0-9._-]*) printf '%s\n' 'check-phase3-p305: invalid run ID' >&2; exit 64 ;; esac
raw_dir="$repository_root/artifacts/raw/$run_id"
build_run="$run_id-build"
build_path="$repository_root/artifacts/builds/$build_run/PanBeat.zip"
if test -e "$raw_dir"; then printf 'check-phase3-p305: evidence directory already exists: %s\n' "$raw_dir" >&2; exit 73; fi
mkdir -p "$raw_dir"
"$script_dir/check-game" --mode test --run-id "$run_id-tests"
"$script_dir/godot" --path "$repository_root/game" --resolution 1280x720 --script res://tests/capture_p305.gd --log-file "$raw_dir/normal.log" -- --mode normal --output "$raw_dir/field-normal.png"
"$script_dir/godot" --path "$repository_root/game" --resolution 1728x720 --script res://tests/capture_p305.gd --log-file "$raw_dir/wide.log" -- --mode wide-monochrome-no-glow --output "$raw_dir/field-wide-monochrome-no-glow.png"
"$script_dir/godot" --path "$repository_root/game" --resolution 1280x720 --script res://tests/capture_p305.gd --log-file "$raw_dir/judgement.log" -- --mode judgement-only --output "$raw_dir/field-judgement-only.png"
! rg -n 'SCRIPT ERROR|ERROR:' "$raw_dir/normal.log" "$raw_dir/wide.log" "$raw_dir/judgement.log"
"$script_dir/check-game" --mode build --run-id "$build_run"
node "$script_dir/summarize-phase3-p305.mjs" "$run_id" "$raw_dir" "$build_path"
printf '%s\n' 'check-phase3-p305: passed'
