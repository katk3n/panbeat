#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
run_id=${1-}
case "$run_id" in ''|*[!A-Za-z0-9._-]*) printf '%s\n' 'run-phase3-p310-real-device: valid RUN_ID required' >&2; exit 64 ;; esac
build_run=${2-phase3-p310-final-20260812-build}
case "$build_run" in ''|*[!A-Za-z0-9._-]*) printf '%s\n' 'run-phase3-p310-real-device: valid BUILD_RUN_ID required' >&2; exit 64 ;; esac
build_zip="$repository_root/artifacts/builds/$build_run/PanBeat.zip"
evidence_root="$repository_root/artifacts/raw/$run_id"
if test ! -f "$build_zip"; then printf 'build missing: %s\n' "$build_zip" >&2; exit 66; fi
mkdir -p "$evidence_root"
session_index=1
session_name=$(printf 'session-%03d' "$session_index")
while test -e "$evidence_root/$session_name"; do
	session_index=$((session_index + 1))
	session_name=$(printf 'session-%03d' "$session_index")
done
evidence="$evidence_root/$session_name"
mkdir -p "$evidence"
temporary=$(mktemp -d /tmp/panbeat-p310-device.XXXXXX)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
unzip -q "$build_zip" -d "$temporary"
printf '{\n  "schema_version": "1.0.0",\n  "story": "P310",\n  "run_id": "%s",\n  "session_id": "%s",\n  "mode": "normal",\n  "status": "awaiting-user-observations",\n  "build": "artifacts/builds/%s/PanBeat.zip",\n  "checks": {\n    "session_completed": null,\n    "tone_readable": null,\n    "ding_converges_and_readable": null,\n    "slap_expands_and_readable": null,\n    "hud_clear": null,\n    "screen_loss": null,\n    "duplicate_results": null,\n    "midi_ui_freeze": null,\n    "visual_quality": null,\n    "glare_or_fatigue": null\n  },\n  "notes": null\n}\n' "$run_id" "$session_name" "$build_run" > "$evidence/session-observations.json"
"$temporary/PanBeat.app/Contents/MacOS/PanBeat" -- --device-diagnostics-output="$evidence/device-diagnostics.json" --calibration-diagnostics-output="$evidence/calibration-diagnostics.json" > "$evidence/application.log" 2>&1
printf 'PanBeat %s ended. Report the observations listed in %s\n' "$session_name" "$evidence/session-observations.json"
