{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panbeat.local/schemas/result-history.schema.json",
  "title": "PanBeat Result History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "max_records", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "max_records": {"type": "integer", "minimum": 1, "maximum": 10000},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "result_id", "completed_at", "metadata", "summary", "timing_distribution", "error_breakdown", "judgements"],
        "properties": {
          "schema_version": {"const": "1.0.0"},
          "result_id": {"type": "string", "minLength": 1},
          "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
          "metadata": {
            "type": "object", "additionalProperties": false,
            "required": ["song_id", "importer_version", "chart_version", "profile_id", "judgement_rule_id", "score_rule_id"],
            "properties": {
              "song_id": {"type": "string", "minLength": 1}, "importer_version": {"type": "string", "minLength": 1},
              "chart_version": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1},
              "judgement_rule_id": {"type": "string", "minLength": 1}, "score_rule_id": {"type": "string", "minLength": 1}
            }
          },
          "summary": {
            "type": "object", "additionalProperties": true,
            "required": ["score", "accuracy", "max_combo", "breakdown"],
            "properties": {"score": {"type": "integer"}, "accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "max_combo": {"type": "integer", "minimum": 0}, "breakdown": {"type": "object"}}
          },
          "timing_distribution": {
            "type": "object", "additionalProperties": false,
            "required": ["sample_count", "median_delta_us", "early_count", "on_time_count", "late_count"],
            "properties": {"sample_count": {"type": "integer", "minimum": 0}, "median_delta_us": {"type": ["integer", "null"]}, "early_count": {"type": "integer", "minimum": 0}, "on_time_count": {"type": "integer", "minimum": 0}, "late_count": {"type": "integer", "minimum": 0}}
          },
          "error_breakdown": {
            "type": "object", "additionalProperties": false,
            "required": ["wrong_target", "wrong_technique", "no_candidate"],
            "properties": {"wrong_target": {"type": "integer", "minimum": 0}, "wrong_technique": {"type": "integer", "minimum": 0}, "no_candidate": {"type": "integer", "minimum": 0}}
          },
          "judgements": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
