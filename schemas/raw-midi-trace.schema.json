{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panbeat.local/schemas/raw-midi-trace.schema.json",
  "title": "PanBeat Raw MIDI Trace JSONL Record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "session_id", "started_at", "clock_domain", "time_unit"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "session" },
        "session_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "clock_domain": { "enum": ["monotonic", "core_midi_host_time", "synthetic"] },
        "time_unit": { "const": "microseconds" },
        "device_name": { "type": "string", "minLength": 1 },
        "human_label": { "type": "string", "minLength": 1 },
        "port_index": { "type": "integer", "minimum": 0 },
        "source_kind": { "enum": ["core_midi", "synthetic"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "session_id", "sequence", "timestamp_us", "clock_domain", "raw_bytes", "message_type"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "event" },
        "session_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "timestamp_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "clock_domain": { "enum": ["monotonic", "core_midi_host_time", "synthetic"] },
        "raw_bytes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "message_type": { "enum": ["note_on", "note_off", "poly_pressure", "control_change", "program_change", "channel_pressure", "pitch_bend", "system"] },
        "channel_wire": { "type": "integer", "minimum": 0, "maximum": 15 },
        "channel_display": { "type": "integer", "minimum": 1, "maximum": 16 },
        "data1": { "type": "integer", "minimum": 0, "maximum": 127 },
        "data2": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    }
  ]
}
