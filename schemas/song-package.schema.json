{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panbeat.local/schemas/song-package.schema.json",
  "title": "PanBeat Imported Song Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "song_id", "import_version", "title", "artist", "duration_us", "chart_schema_version", "artwork_path", "status", "importer_version", "profile_id", "cache_key", "source", "overlay_sha256", "audio", "chart_path"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "song_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "import_version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "artist": {"type": "string"},
    "handpan_scale_name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S(?:[^\\r\\n\\t]*\\S)?$"},
    "duration_us": {"type": "integer", "minimum": 0},
    "chart_schema_version": {"const": "1.0.0"},
    "artwork_path": {"type": "string"},
    "status": {"const": "valid"},
    "importer_version": {"enum": ["panbeat-musicxml-importer-v1", "panbeat-score-importer-v2", "panbeat-musicxml-importer-v2", "panbeat-score-importer-v3"]},
    "profile_id": {"type": "string", "minLength": 1},
    "performance_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_version", "strategy", "layout_id", "slots"],
      "properties": {
        "layout_version": {"const": "1.0.0"},
        "strategy": {"const": "lowest-ding-ascending-zigzag-v1"},
        "layout_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "slots": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["technique", "target_id", "midi_note", "display_names"],
            "properties": {
              "technique": {"enum": ["tone", "ding"]},
              "target_id": {"type": "string", "pattern": "^(ding|tone-[1-8])$"},
              "midi_note": {"type": "integer", "minimum": 0, "maximum": 127},
              "display_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notation_octave_shift": {"enum": [-1, 0]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_name", "archive_rootfile", "extension", "sha256", "bytes", "archive_entries"],
      "properties": {
        "format": {"enum": ["musicxml", "notepan"]},
        "stored_path": {"enum": ["source.musicxml", "source.pan"]},
        "original_name": {"type": "string", "minLength": 1},
        "archive_rootfile": {"type": "string"},
        "extension": {"enum": [".musicxml", ".xml", ".mxl", ".pan"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "archive_entries": {"type": "array", "maxItems": 256}
      }
    },
    "overlay_sha256": {"anyOf": [{"const": "none"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "runtime_path"],
      "properties": {
        "present": {"type": "boolean"},
        "source_sha256": {"anyOf": [{"const": "none"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "runtime_path": {"enum": ["", "runtime.ogg"]}
      }
    },
    "chart_path": {"const": "chart.json"},
    "import_diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "file", "element", "message", "remediation"],
        "properties": {
          "severity": {"const": "warning"},
          "code": {"type": "string", "minLength": 1},
          "file": {"type": "string"},
          "part": {"type": "string"},
          "measure": {"type": "string"},
          "element": {"type": "string"},
          "message": {"type": "string", "minLength": 1},
          "remediation": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "1.0.0"}}, "required": ["schema_version"]}, "then": {"properties": {"handpan_scale_name": false, "import_diagnostics": false}}},
    {"if": {"properties": {"schema_version": {"const": "1.2.0"}}, "required": ["schema_version"]}, "then": {"required": ["import_diagnostics"], "properties": {"source": {"type": "object", "required": ["format", "stored_path"], "properties": {"format": {"enum": ["musicxml", "notepan"]}, "stored_path": {"enum": ["source.musicxml", "source.pan"]}}}}}},
    {"if": {"properties": {"importer_version": {"const": "panbeat-score-importer-v2"}}, "required": ["importer_version"]}, "then": {"properties": {"schema_version": {"const": "1.2.0"}, "notation_octave_shift": {"const": 0}, "overlay_sha256": {"const": "none"}, "source": {"type": "object", "properties": {"format": {"const": "notepan"}, "stored_path": {"const": "source.pan"}, "extension": {"const": ".pan"}}}}}},
    {"if": {"properties": {"schema_version": {"const": "1.3.0"}}, "required": ["schema_version"]}, "then": {"required": ["performance_layout", "import_diagnostics"], "properties": {"performance_layout": true, "import_diagnostics": true, "source": {"type": "object", "required": ["format", "stored_path"], "properties": {"format": true, "stored_path": true}}}}},
    {"if": {"properties": {"importer_version": {"const": "panbeat-musicxml-importer-v2"}}, "required": ["importer_version"]}, "then": {"properties": {"schema_version": {"const": "1.3.0"}, "source": {"type": "object", "properties": {"format": {"const": "musicxml"}, "stored_path": {"const": "source.musicxml"}}}}}},
    {"if": {"properties": {"importer_version": {"const": "panbeat-score-importer-v3"}}, "required": ["importer_version"]}, "then": {"properties": {"schema_version": {"const": "1.3.0"}, "notation_octave_shift": {"const": 0}, "overlay_sha256": {"const": "none"}, "source": {"type": "object", "properties": {"format": {"const": "notepan"}, "stored_path": {"const": "source.pan"}, "extension": {"const": ".pan"}}}}}}
  ]
}
