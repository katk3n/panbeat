{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panbeat.local/schemas/panbeat-chart.schema.json",
  "title": "PanBeat Phase 0 Chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chart_id", "clock_domain", "time_unit", "duration_us", "notes"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "chart_id": { "type": "string", "minLength": 1 },
    "clock_domain": { "const": "song_time" },
    "time_unit": { "const": "microseconds" },
    "duration_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "timestamp_us", "technique", "target_id"],
        "properties": {
          "note_id": { "type": "string", "minLength": 1 },
          "timestamp_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "technique": { "enum": ["tone", "ding", "slap"] },
          "target_id": { "type": "string", "minLength": 1 },
          "hand": { "enum": ["right", "left", "unspecified"] }
        }
      }
    }
  }
}
