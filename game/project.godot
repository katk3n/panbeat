config_version=5

[application]
config/name="PanBeat"
config/icon="res://assets/branding/panbeat-icon.png"
run/main_scene="res://presentation/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
environment/defaults/default_clear_color=Color(0.0117647, 0.0196078, 0.0627451, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
